{
  "name": "my-life-simulator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --exclude src/lib/simulation-stress.test.ts",
    "build": "npm run check && npm test && vite build",
    "build:app": "vite build",
    "test:simulation": "vitest run src/lib/simulation-stress.test.ts"
  },
  "dependencies": {
    "svelte": "5.25.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "svelte-check": "4.1.5",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "3.0.8"
  }
}
