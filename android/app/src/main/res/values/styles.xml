<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">#000000</item>
    <!-- Android's system splash is icon-only; the full-screen original artwork is
         displayed by MainActivity immediately after this brief system handoff. -->
    <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    <item name="postSplashScreenTheme">@style/NormalTheme</item>
  </style>
  <style name="NormalTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#72D69A</item>
    <item name="android:statusBarColor">#000000</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowActionModeOverlay">true</item>
  </style>
</resources>
